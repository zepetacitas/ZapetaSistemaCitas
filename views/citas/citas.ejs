
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Citas</title>

    <link rel="stylesheet" href="/css/citas.css">
    <link rel="stylesheet" href="/css/toast.css">

    <script src="/js/citas.js" defer></script>
</head>

<body>

<div class="contenedor">

    <!-- BARRA SUPERIOR -->
    <div class="top-bar">

        <h2 class="titulo">Módulo Citas</h2>

        <div class="lado-derecho">

            <img src="/img/logo.png" class="logo" alt="Logo">

            <!-- REGRESAR AL MENÚ PHP -->
            <a href="/" class="btn-icon" title="Inicio">🏠</a>

            <!-- CERRAR SESIÓN -->
            <a href="/logout" class="btn-salir">Salir</a>

        </div>

    </div>

    <!-- FORMULARIO -->
    <div class="formulario">

        <form method="POST" action="/citas" id="formularioCita" novalidate>

            <input
                type="hidden"
                name="folio"
                value="<%= editar?.folio || '' %>"
            >

            <div class="grid-form">

                <input
                    type="text"
                    name="nombre"
                    placeholder="Nombre"
                    value="<%= editar?.nombre || '' %>"
                    required
                >

                <input
                    type="text"
                    name="apellido"
                    placeholder="Apellido"
                    value="<%= editar?.apellido || '' %>"
                    required
                >

                <input
                    type="email"
                    name="correo"
                    placeholder="Correo electrónico"
                    value="<%= editar?.correo || '' %>"
                    required
                >

                <select name="area" required>

                    <option value="">Seleccionar área</option>

                    <% const areas = [
                        "Nutrición",
                        "Yoga",
                        "Psicología",
                        "Psicología infantil",
                        "Tanatología",
                        "Servicios jurídicos",
                        "Inglés",
                        "Pedagogía"
                    ]; %>

                    <% areas.forEach(area => { %>

                        <option
                            value="<%= area %>"
                            <%= editar?.area === area ? "selected" : "" %>
                        >
                            <%= area %>
                        </option>

                    <% }); %>

                </select>

                <input
                    type="date"
                    name="fecha"
                    id="fecha"
                    value="<%= editar?.fecha || '' %>"
                    required
                >

                <input
                    type="time"
                    name="hora"
                    id="hora"
                    min="07:00"
                    max="20:00"
                    step="60"
                    value="<%= editar?.hora || '' %>"
                    required
                >

            </div>

            <div class="acciones-form">

                <button
                    type="submit"
                    name="guardar"
                    value="1"
                    class="btn-guardar"
                >
                    <%= editar?.folio ? "Actualizar" : "Guardar" %>
                </button>

            </div>

        </form>

    </div>

    <!-- BUSCADOR -->
    <div class="buscador">

        <form method="POST" action="/citas/buscar" class="form-busqueda">

            <input
                type="text"
                name="buscar"
                placeholder="Buscar por folio o nombre"
                value="<%= typeof busqueda !== 'undefined' ? busqueda : '' %>"
            >

            <div class="acciones-buscador">

                <button type="submit" class="btn-buscar">
                    Buscar
                </button>

                <a href="/citas" class="btn-mostrar">
                    Mostrar todos
                </a>

                <a href="/citas/pdf" target="_blank" class="btn-pdf">
                    PDF
                </a>

            </div>

        </form>

    </div>

    <!-- TABLA -->
    <div class="tabla-responsive">

        <table>

            <thead>
                <tr>
                    <th>Folio</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Área</th>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                <% if (datos && datos.length > 0) { %>

                    <% datos.forEach(c => { %>

                        <tr>

                            <td><%= c.folio %></td>
                            <td><%= c.nombre %></td>
                            <td><%= c.apellido %></td>
                            <td><%= c.area %></td>
                            <td><%= c.fecha %></td>
                            <td><%= c.hora %></td>

                            <td>

                                <div class="acciones-tabla">

                                    <a
                                        href="/citas?editar=<%= encodeURIComponent(c.folio) %>"
                                        class="btn-actualizar"
                                    >
                                        Editar
                                    </a>

                                    <form
                                        method="POST"
                                        action="/citas/eliminar"
                                        class="form-eliminar"
                                    >

                                        <input
                                            type="hidden"
                                            name="folio"
                                            value="<%= c.folio %>"
                                        >

                                        <button
                                            type="submit"
                                            class="btn-eliminar"
                                        >
                                            Eliminar
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                    <% }); %>

                <% } else { %>

                    <tr>
                        <td colspan="7" class="sin-registros">
                            No hay citas registradas.
                        </td>
                    </tr>

                <% } %>

            </tbody>

        </table>

    </div>

</div>

<!-- NOTIFICACIONES -->
<div
    id="toastContainer"
    class="toast-container"
    role="status"
    aria-live="polite"
></div>

<div
    id="mensajeServidor"
    hidden
    data-mensaje="<%= typeof error !== 'undefined' && error ? error : '' %>"
></div>

<div
    id="mensajeExito"
    hidden
    data-mensaje="<%= typeof exito !== 'undefined' && exito ? exito : '' %>"
></div>

<div
    id="confirmacionEliminar"
    hidden
    data-mensaje="¿Estás seguro de que deseas eliminar esta cita?"
></div>

</body>
</html>
