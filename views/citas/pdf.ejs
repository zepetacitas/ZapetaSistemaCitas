<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Reporte de Citas</title>


    <style>

        body {
            font-family: Arial, sans-serif;
            padding: 20px;
        }


        .acciones {
            margin-bottom: 20px;
        }


        .btn-imprimir {
            padding: 10px 18px;
            border: none;
            border-radius: 5px;
            background: #333;
            color: white;
            cursor: pointer;
            font-size: 14px;
        }


        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }


        .logo {
            width: 100px;
        }


        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }


        th {
            background: #333;
            color: #fff;
            padding: 8px;
        }


        td {
            border: 1px solid #ccc;
            padding: 6px;
        }


        tr:nth-child(even) {
            background: #f2f2f2;
        }


        @media print {

            .acciones {
                display: none;
            }

            body {
                padding: 0;
            }

        }

    </style>

</head>


<body>


<!-- ========================= -->
<!-- BOTÓN IMPRIMIR -->
<!-- ========================= -->

<div class="acciones">

    <button
        onclick="window.print()"
        class="btn-imprimir"
    >
        🖨️ Imprimir PDF
    </button>

</div>


<!-- ========================= -->
<!-- ENCABEZADO -->
<!-- ========================= -->

<div class="header">


    <img
        src="/img/logo.png"
        class="logo"
        alt="Logo"
    >


    <div>

        <h2>
            Reporte de Citas
        </h2>

        <p>
            Sistema Zepeta
        </p>

    </div>


    <div>

        <%= fecha %>

    </div>


</div>


<!-- ========================= -->
<!-- TABLA -->
<!-- ========================= -->

<table>

    <thead>

        <tr>

            <th>#</th>

            <th>Folio</th>

            <th>Nombre</th>

            <th>Apellido</th>

            <th>Área</th>

            <th>Fecha</th>

            <th>Hora</th>

        </tr>

    </thead>


    <tbody>

        <% if (datos && datos.length > 0) { %>

            <% datos.forEach((c, index) => { %>

                <tr>

                    <td>
                        <%= index + 1 %>
                    </td>

                    <td>
                        <%= c.folio %>
                    </td>

                    <td>
                        <%= c.nombre %>
                    </td>

                    <td>
                        <%= c.apellido %>
                    </td>

                    <td>
                        <%= c.area %>
                    </td>

                    <td>
                        <%= c.fecha %>
                    </td>

                    <td>
                        <%= c.hora %>
                    </td>

                </tr>

            <% }); %>

        <% } else { %>

            <tr>

                <td
                    colspan="7"
                    style="text-align:center;"
                >
                    No hay citas registradas.
                </td>

            </tr>

        <% } %>

    </tbody>

</table>


</body>

</html>